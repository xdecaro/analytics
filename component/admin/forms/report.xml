<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset name="basic">
    <field name="id" type="hidden" />
    <field name="title" type="text" required="true" maxlength="255" label="COM_XDECAROANALYTICS_FIELD_TITLE" />
    <field name="provider_key" type="text" required="true" maxlength="100" label="COM_XDECAROANALYTICS_FIELD_PROVIDER" description="COM_XDECAROANALYTICS_FIELD_PROVIDER_DESC" />
    <field name="source_type" type="list" required="true" default="metric" label="COM_XDECAROANALYTICS_FIELD_SOURCE_TYPE">
      <option value="metric">COM_XDECAROANALYTICS_SOURCE_METRIC</option>
      <option value="dataset">COM_XDECAROANALYTICS_SOURCE_DATASET</option>
    </field>
    <field name="source_key" type="text" required="true" maxlength="100" label="COM_XDECAROANALYTICS_FIELD_SOURCE_KEY" />
    <field name="context_json" type="textarea" rows="8" filter="raw" label="COM_XDECAROANALYTICS_FIELD_CONTEXT" description="COM_XDECAROANALYTICS_FIELD_CONTEXT_DESC" />
    <field name="scheduled" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_XDECAROANALYTICS_FIELD_SCHEDULED"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="state" type="list" default="1" label="JSTATUS"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option></field>
  </fieldset>
</form>
